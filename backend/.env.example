# Copy to backend/.env (gitignored) and fill in. Never commit .env or the key file.

# Google Sheets: path to the service-account key file (keep it OUTSIDE the repo), or the JSON itself on one line
GOOGLE_SERVICE_ACCOUNT_JSON=~/.config/jobfinder/sheets-key.json
# the long id in your sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Free LLM (optional). none = deterministic plan
LLM_PROVIDER=none
# Ollama (local):  LLM_PROVIDER=openai  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama
# Groq (free tier): LLM_PROVIDER=openai  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile  LLM_API_KEY=gsk_...
