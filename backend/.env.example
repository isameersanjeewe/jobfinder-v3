# Copy to backend/.env (gitignored) and fill in. Never commit .env or the key file.

# Google Sheets: path to the service-account key file (keep it OUTSIDE the repo), or the JSON itself on one line
GOOGLE_SERVICE_ACCOUNT_JSON=~/.config/jobfinder/sheets-key.json
# the long id in your sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Free LLM (optional). none = deterministic plan
LLM_PROVIDER=none
# Ollama (local):  LLM_PROVIDER=openai  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama
# Groq (free tier): LLM_PROVIDER=openai  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile  LLM_API_KEY=gsk_...

# Security (required when the API is reachable from the internet, e.g. Render):
# API_TOKEN: any long random string; paste the same value in the web UI under "Connection settings".
#   generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# ALLOWED_ORIGINS: comma-separated origins allowed to call the API from a browser (default *)
ALLOWED_ORIGINS=*
# JOBSPY_TIMEOUT=120

# Multi-user (required when the API is reachable from the internet, see docs/MULTI_USER_SETUP.md):
# SESSION_SECRET: any long random string, signs per-user session tokens issued by POST /auth/login.
#   generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# SESSION_DAYS=30

# Multi-user persistence (optional; leave unset to keep running fully in-process against local SQLite,
# which is what local dev and the test suite do). Set these only after completing the one-time setup in
# docs/MULTI_USER_SETUP.md (creating the private "jobfinder-data" repo and its fine-grained PAT):
# DATA_REPO_TOKEN=        # fine-grained GitHub PAT: contents:write + actions:write on that repo only
# DATA_REPO=               # "your-github-username/jobfinder-data"
# DATA_REPO_WORKFLOW=run-agent.yml
# DATA_REPO_BRANCH=main
